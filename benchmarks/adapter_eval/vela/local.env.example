# SPDX-License-Identifier: Apache-2.0
#
# Copy to vela/local/local.env (gitignored) and fill in. submit.sh sources it
# with bash, so $VARS expand. Never put secret values here: the judge key is
# read in the pod from a Kubernetes secret, by name.

# Cluster
NAMESPACE=<namespace>
QUEUE_NAME=default-queue
PRIORITY=default-priority
CONTAINER_IMAGE=<registry>/<image>:<tag>
IMAGE_PULL_SECRET=<image pull secret name>
# CHART=mlbatch/pytorchjob-generator
# JOB_PREFIX=adapter-bench

# Storage: one PVC, mounted at PVC_MOUNT in the pod.
PVC_NAME=<claim name>
PVC_MOUNT=/mnt/adapter-bench
# Staged adapters + eval sets (written by `submit.sh stage`, read by bench).
BENCH_ROOT=$PVC_MOUNT/<path>/adapter-bench/v1
# Per-run outputs: manifests, predictions, full score reports.
WORK_ROOT=$PVC_MOUNT/<path>/adapter-bench/runs
# Optional: Hugging Face cache on the mount, and a local base-model copy.
# HF_HOME=$PVC_MOUNT/<path>/hf-cache
# BASE_MODEL_PATH=$PVC_MOUNT/<path>/granite-4.1-3b

# Where `submit.sh discover` looks (space-separated). An entry may be
# "<intrinsic id>=<dir>", naming the intrinsic of runs whose path does not.
ADAPTER_SOURCE_ROOTS="$PVC_MOUNT/<adapter runs dir> answerability=$PVC_MOUNT/<another dir>"
EVAL_SOURCE_ROOTS="$PVC_MOUNT/<eval data dir>"

# The query-rewrite LLM judge. Only jobs that score with it get these, and
# query rewrite is left out of adapters.yaml for now.
# JUDGE_URL=https://<openai-compatible endpoint>/v1
# JUDGE_MODEL=<model id>
# JUDGE_SECRET_NAME=<k8s secret holding the API key>
# JUDGE_SECRET_KEY=<key inside that secret>

# Reference columns (`submit.sh reference`): a local shadow-residual checkout
# and the commit whose SR model code the pod runs. Only that code is shipped,
# with git archive; the results record just the full sha. Pin a sha, and bump
# reference_version in adapters.yaml when you change it.
# SR_REPO=<path to a shadow-residual checkout>
# SR_REF=<commit sha>

# Stage inputs (defaults shown).
# SELECTION_FILE=$LOCAL_DIR/selection.json
# JUDGE_PROMPT_FILE=$LOCAL_DIR/judge_prompt.txt

# Reference input (default shown): the base model's instructions, one per
# intrinsic, as {"<intrinsic id>": {"mode": "append" | "replace_last_user",
# "text": "..."}}. Shipped with each reference job; the results record only its
# checksum.
# BASE_INSTRUCTIONS_FILE=$LOCAL_DIR/base_instructions.json

# Other models (`--model <id>`, an adapters.yaml id other than the first):
# their own settings take a suffix, the id with '-' and '.' as '_'. The plain
# names above are the first model's and are never used for another model.
# BENCH_ROOT is required; without BASE_MODEL_PATH the pod downloads the base
# model by name. Their selection defaults to $LOCAL_DIR/selection.<id>.json.
# BENCH_ROOT__granite_4_2_3b=$PVC_MOUNT/<path>/adapter-bench/granite-4.2-3b/v1
# BASE_MODEL_PATH__granite_4_2_3b=$PVC_MOUNT/<path>/granite-4.2-3b
# SELECTION_FILE__granite_4_2_3b=$LOCAL_DIR/selection.granite-4.2-3b.json

# Optional: override the pod's install (default: uv sync --frozen --group dev).
# UV_SYNC_ARGS="--group dev"
